{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "packageManager": "npm", "analytics": false },
  "newProjectRoot": "projects",
  "projects": {
    "onboarding-web": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "i18n": { "sourceLocale": "en" },
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "polyfills": ["@angular/localize/init"],
            "baseHref": "/onboarding/",
            "tsConfig": "tsconfig.app.json",
            "assets": [{ "glob": "**/*", "input": "public" }],
            "styles": ["src/styles.css"]
          },
          "configurations": {
            "production": {
              "budgets": [
                { "type": "initial", "maximumWarning": "1MB", "maximumError": "2MB" },
                { "type": "anyComponentStyle", "maximumWarning": "6kB", "maximumError": "12kB" }
              ],
              "outputHashing": "all"
            },
            "development": { "optimization": false, "extractLicenses": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": { "buildTarget": "onboarding-web:build:production" },
            "development": { "buildTarget": "onboarding-web:build:development" }
          },
          "defaultConfiguration": "development",
          "options": {
            "host": "127.0.0.1",
            "port": 4300,
            "proxyConfig": "proxy.conf.json",
            "allowedHosts": ["localhost", ".ngrok-free.app"]
          }
        },
        "extract-i18n": { "builder": "@angular/build:extract-i18n" },
        "test": { "builder": "@angular/build:unit-test" }
      }
    }
  }
}
