# Copy to .env (gitignored). scripts/entra.py fills the Entra IDs; scripts/agent-deploy.sh fills AGENT_RUNTIME_ARN.
NGROK_DOMAIN=mutually-exotic-bonefish.ngrok-free.app
# The demo uses only /mcp on that domain (chatbot /mcp/, MCP Gateway /mcp/gw/...). Other paths go to this local port
# (another app sharing the domain), or get 404 when it is empty.
NGROK_ROOT_UPSTREAM=
AWS_REGION=ap-southeast-1
BEDROCK_MODEL_ID=
TENANT_ID=
GATEWAY_API_CLIENT_ID=
AGENT_API_CLIENT_ID=
CHAT_CLIENT_ID=
CLI_CLIENT_ID=
DEMO_USER_OPERATOR=
DEMO_USER_FULL=
DEMO_USER_WEATHER_ONLY=
DEMO_USER_AGENT_ONLY=
DEMO_USER_NONE=
AGENT_RUNTIME_ARN=
# Agent tool route: mcp-gateway (direct, default) or agentcore-gateway. Set by `TOOLS_VIA=... make agent`.
TOOLS_VIA=
# AgentCore Gateways (scripts/agentcore-gateway.sh fills this)
# one AgentCore Gateway per adapter: weather=https://<gateway>,hr-directory=https://<gateway>
AGENTCORE_GATEWAY_URLS=
# Agent model loop: claude (default) or bedrock-agent (scripts/bedrock-agent.sh fills the ids)
AGENT_ENGINE=
BEDROCK_AGENT_ID=
BEDROCK_AGENT_ALIAS_ID=
# Chatbot -> agent route: direct (default) or agentcore-gateway (inbound gateway, token passthrough)
AGENT_VIA=
AGENT_GATEWAY_URL=
